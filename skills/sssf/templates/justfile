# SSSF starter recipes. Stamped by install.py, then yours to edit.
#
# Deliberately small. These are the handful you need on day one: run something,
# watch it, and open the trace. Add your own as your chains grow, and see the
# example branch for the fuller set (orchestrator agents, kill, rosters, ipi).

# `.env` reaches every ADW through this, so keys work without exporting them.
set dotenv-load
set positional-arguments

# Every recipe passes this through, so `SSSF_CONFIG=other.yaml just sdlc "..."`
# swaps the whole roster for one run.
config := env_var_or_default("SSSF_CONFIG", "adws/adw_sssf_config/sssf.config.yaml")
db     := "adws/adw_data/sssf.db"
# Where the sssf skill itself lives — the operational scripts (up, issue_watch,
# pr_watch, kill_run, worktrees) and the trace UI are read from there, not from
# this repo. Every agent keeps its skills somewhere else (.claude/skills,
# ~/.pi/agent/skills, ~/.codex/skills, ~/.config/opencode/skills, ~/.agents/skills),
# so there is no default worth guessing: install.py writes the path it ran from
# into .env, which is the one moment anything knows it. Resolved in the recipe
# shell, not at parse time, so cron sees exactly what an interactive run sees.
skill  := '"${SSSF_SKILL:?not set - re-run install.py, which writes it into .env}"'

# list every recipe
default:
    @just --list

# ── run the factory ─────────────────────────────────────────────────────────
# The factory has three long-running parts — the trace UI, the issue watcher and
# the review watcher — and forgetting one is silent: a watcher that is not
# running looks exactly like a watcher with nothing to do. So they start
# together, in one foreground process that owns all of them, and ctrl-c stops
# the lot. The individual recipes below still exist for cron and for debugging.

# start everything: trace UI + both watchers, ctrl-c stops it all
up *ARGS:
    uv run {{skill}}/scripts/up.py --config {{config}} "$@"

# is anything actually running? watchers, their last poll, runs in flight
status:
    @uv run {{skill}}/scripts/up.py status --config {{config}}

# ── first run ───────────────────────────────────────────────────────────────

# Proves the whole path works: config validated, session minted, agent ran,
# envelope parsed, gates checked, trace written. Costs a few cents and changes
# nothing in your repo, because both workflows are read-only.
#
# (`just --list` shows only the LAST comment line, so that one is the summary.)

# start here: two cheap read-only runs, end to end
demo:
    @echo "1/2  adw_prompt: one agent, one prompt"
    uv run adws/adw_prompt.py --config {{config}} --agent scout "reply with a one-line summary of this repo"
    @echo "\n2/2  adw_scout: read-only recon"
    uv run adws/adw_scout.py --config {{config}} "list the top-level directories in this repo and what each is for. change nothing."
    @echo "\nboth done. now run:  just sessions    (or: just obs)"

# ── run a workflow ──────────────────────────────────────────────────────────
# Args pass straight through: "<prompt or path/to/prompt.md>" [--adw-id X]

# one agent, one prompt: just prompt "summarize this repo"
prompt *ARGS:
    uv run adws/adw_prompt.py --config {{config}} "$@"

# read-only recon: just scout "where is auth handled"
scout *ARGS:
    uv run adws/adw_scout.py --config {{config}} "$@"

# plan only: just plan "add a /health endpoint"
plan *ARGS:
    uv run adws/adw_plan.py --config {{config}} "$@"

# planner, builder, commit: just plan-build "add a /health endpoint"
plan-build *ARGS:
    uv run adws/adw_plan_build.py --config {{config}} "$@"

# plan, build, test, commit: just sdlc "add a /health endpoint"
sdlc *ARGS:
    uv run adws/adw_plan_build_test.py --config {{config}} "$@"

# the full chain, plus review and docs: just simple-sdlc "add a /health endpoint"
simple-sdlc *ARGS:
    uv run adws/adw_simple_sdlc.py --config {{config}} "$@"

# ── from an issue ───────────────────────────────────────────────────────────
# The label is the authorization: a human applies it, the watcher only ever
# looks at issues carrying it, and the flip off it is the lock. Off until
# `issues.enabled` says otherwise — see the issues block in the config.

# work one issue end to end: just issue 42
issue NUMBER *ARGS:
    uv run adws/adw_issue_sdlc.py {{NUMBER}} --config {{config}} {{ARGS}}

# read-only triage, comments its findings: just issue-scout 42
issue-scout NUMBER *ARGS:
    uv run adws/adw_issue_scout.py {{NUMBER}} --config {{config}} {{ARGS}}

# poll once and launch what is labelled: just issues
issues:
    uv run {{skill}}/scripts/issue_watch.py once --config {{config}}

# what the watcher would do, and whether it can: just issues-status
issues-status:
    @uv run {{skill}}/scripts/issue_watch.py status --config {{config}}

# keep polling — the cron form; `just up` is the one for a terminal
issues-watch *ARGS:
    uv run {{skill}}/scripts/issue_watch.py loop --config {{config}} "$@"

# ── answer a review ─────────────────────────────────────────────────────────
# The other end of a branch's life. A run's pull request draws comments; this
# joins the SAME session, works the branch it already has, and pushes onto it —
# so the pull request is updated, never replaced. Unresolved threads are the
# queue: a run answers them and resolves them, so nothing is worked twice.

# answer the open review threads on one PR: just pr-review 17
pr-review NUMBER *ARGS:
    uv run adws/adw_pr_review.py {{NUMBER}} --config {{config}} {{ARGS}}

# poll once and answer what has feedback: just prs
prs:
    uv run {{skill}}/scripts/pr_watch.py once --config {{config}}

# what the review watcher would do, and whether it can: just prs-status
prs-status:
    @uv run {{skill}}/scripts/pr_watch.py status --config {{config}}

# An unpinned watcher never exits on a merge — `just up` runs it that way, and
# only this pinned form is finished when the pull request it follows is.

# keep polling — the cron form; --pr <n> watches one and exits when it merges
prs-watch *ARGS:
    uv run {{skill}}/scripts/pr_watch.py loop --config {{config}} "$@"

# ── land a run's branch ─────────────────────────────────────────────────────
# Every run works on its own sssf/<adw_id> branch in its own worktree. Chains
# stop at a committed branch; this is what brings it back to the base branch,
# the way worktree.integration in the config says to.

# merge or push a finished run: just integrate <adw_id>
integrate ADW_ID *ARGS:
    uv run adws/adw_integrate.py --config {{config}} --adw-id {{ADW_ID}} {{ARGS}}

# ── watch it ────────────────────────────────────────────────────────────────
# Reads never block a running workflow, the db is WAL. Poll as hard as you like.

# the last 10 runs
sessions:
    @sqlite3 {{db}} "select adw_id, status, substr(request,1,50), total_tokens, round(total_cost,4) from sessions order by started_at desc limit 10;"

# phase status in sequence: just phases <adw_id>
phases ADW_ID:
    @sqlite3 {{db}} "select seq, name, kind, owner, status, attempt from phases where adw_id='{{ADW_ID}}' order by seq;"

# the live event tail: just tail <adw_id>
tail ADW_ID:
    @sqlite3 {{db}} "select rowid, type, name, started_at from events where adw_id='{{ADW_ID}}' order by rowid desc limit 25;"

# stop a run — agent children first, then the workflow: just kill <adw_id>
kill ADW_ID *ARGS:
    uv run {{skill}}/scripts/kill_run.py {{ADW_ID}} --config {{config}} {{ARGS}}

# what a run has alive right now, with pids: just procs <adw_id>
procs ADW_ID:
    @sqlite3 {{db}} "select kind, name, pid, command, started_at from processes where adw_id='{{ADW_ID}}' and ended_at is null order by id;"

# ── worktrees ───────────────────────────────────────────────────────────────
# A failed or killed run keeps its worktree on purpose — that is where you go to
# see what happened. These are how you find them again and reclaim the disk.

# every run worktree, with the state of the run that owns it
worktrees:
    @uv run {{skill}}/scripts/worktrees.py list

# remove the worktrees of ended runs that have nothing uncommitted in them
worktrees-prune *ARGS:
    uv run {{skill}}/scripts/worktrees.py prune "$@"

# drop one run's worktree, branch retained: just worktree-rm <adw_id>
worktree-rm ADW_ID *ARGS:
    uv run {{skill}}/scripts/worktrees.py remove {{ADW_ID}} {{ARGS}}

# ── observability UI ────────────────────────────────────────────────────────

# Needs bun. This is `just up --only obs`, not a second implementation. The UI
# is TWO processes — the json api and vite — and an earlier version of this
# recipe backgrounded the api in a subshell, so ctrl-c killed vite and left the
# api holding :4600; the next `just obs` then died on EADDRINUSE. up.py owns
# both, passes the db path the config names, and takes both down on ctrl-c.

# boot the trace UI alone, http://localhost:4601 (api on :4600)
obs:
    uv run {{skill}}/scripts/up.py --config {{config}} --only obs

# ── remove the factory ──────────────────────────────────────────────────────
# The inverse of install.py, and the one recipe here that cannot be undone: it
# deletes adws/ entire — the run record and your prompt and config edits with
# it — plus the run worktrees, .env.sample and this justfile. Always look at
# `just uninstall-plan` first; the real one asks before it does anything.

# what an uninstall would delete, and what it would keep. Changes nothing
uninstall-plan:
    @uv run {{skill}}/scripts/uninstall.py --dry-run --config {{config}}

# delete the stamped factory from this repo. The skill is untouched
uninstall *ARGS:
    uv run {{skill}}/scripts/uninstall.py --config {{config}} "$@"
